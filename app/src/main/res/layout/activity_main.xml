<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BVR"
                android:textColor="?attr/colorAccent"
                android:textSize="27sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtRecordingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● READY"
                android:textColor="?attr/colorAccent"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Background Video Recorder"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Record videos in the background."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <!-- RECORDING TIMER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#151D1A"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECORDING TIME"
                android:textColor="#A5AAA8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="00:00:00"
                android:textColor="#00D6A0"
                android:textSize="32sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CAMERA PREVIEW -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#151D1A"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CAMERA PREVIEW"
                android:textColor="#00D6A0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/cameraPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:background="#080B0A">

                <TextView
                    android:id="@+id/txtPreviewPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Camera preview will appear here"
                    android:textColor="#A5AAA8"
                    android:textSize="14sp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Show Live Preview"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="?attr/colorAccent" />

            </LinearLayout>

        </LinearLayout>

        <!-- CAMERA SELECTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SELECT CAMERA"
            android:textColor="#00D6A0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#151D1A"
            android:orientation="horizontal"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rbBackCamera"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:buttonTint="#00D6A0"
                android:checked="true"
                android:text="Back Camera"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbFrontCamera"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:buttonTint="#00D6A0"
                android:text="Front Camera"
                android:textColor="#FFFFFF" />

        </RadioGroup>

        <!-- VIDEO QUALITY -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="VIDEO QUALITY"
            android:textColor="#00D6A0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spVideoQuality"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="9dp"
            android:background="#1B2521"
            android:padding="10dp" />

        <TextView
            android:id="@+id/txtQualityInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="480p and 720p FREE | 1080p AD UNLOCK"
            android:textColor="#00D6A0"
            android:textSize="12sp" />

        <!-- AUDIO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:background="#151D1A"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Record Audio"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="?attr/colorAccent" />

        </LinearLayout>

        <!-- RECORDING STORAGE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#151D1A"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECORDING STORAGE"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- TOTAL STORAGE -->

            <TextView
                android:id="@+id/txtStorageTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="TOTAL STORAGE: 1 GB"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- STORAGE PROGRESS -->

            <ProgressBar
                android:id="@+id/storageProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00D6A0"
                android:progressBackgroundTint="#39443F" />

            <!-- USED STORAGE -->

            <TextView
                android:id="@+id/txtStorageUsed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Used: 0 MB"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- AVAILABLE STORAGE -->

            <TextView
                android:id="@+id/txtStorageAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Available: 1 GB"
                android:textColor="#00D6A0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- STORAGE PERCENTAGE -->

            <TextView
                android:id="@+id/txtStoragePercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0% USED"
                android:textColor="#A5AAA8"
                android:textSize="12sp" />

            <!-- OLD STORAGE ID - KEPT FOR COMPATIBILITY -->

            <TextView
                android:id="@+id/txtStorageInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 MB USED / 1 GB FREE"
                android:textColor="#00D6A0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Your free recording storage allowance"
                android:textColor="#A5AAA8"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- START / STOP RECORDING -->

        <Button
            android:id="@+id/btnStartRecording"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00D6A0"
            android:text="● START RECORDING"
            android:textColor="#07100D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- RECORDINGS -->

        <Button
            android:id="@+id/btnRecordings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="13dp"
            android:backgroundTint="#1B2521"
            android:text="MY RECORDINGS"
            android:textColor="#FFFFFF" />

        <!-- SETTINGS -->

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1B2521"
            android:text="SETTINGS"
            android:textColor="#FFFFFF" />

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Use responsibly and follow local laws."
            android:textColor="#777F7B"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>