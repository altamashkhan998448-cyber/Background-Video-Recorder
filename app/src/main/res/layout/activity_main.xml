<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAF2">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <!-- TOP HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BVR"
                android:textColor="#101710"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:background="#DDEFE0"
                android:gravity="center"
                android:text="💎"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/txtRecordingStatus"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="#D8F4DD"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="● Ready"
                android:textColor="#183D25"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- STORAGE AND QUICK SETTINGS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="205dp"
            app:cardBackgroundColor="#DDF5E1"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- STORAGE GAUGE -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="164dp"
                        android:layout_height="164dp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="#E8F8E9"
                        app:cardCornerRadius="100dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#B66A00"
                        app:strokeWidth="9dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtStorageTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 GB"
                                android:textColor="#171717"
                                android:textSize="29sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="free"
                                android:textColor="#444444"
                                android:textSize="20sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

                <!-- QUICK SETTING TILES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.65"
                    android:orientation="vertical">

                    <!-- FIRST ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="5dp"
                            app:cardBackgroundColor="#F0F8EC"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⏱  30 Min"
                                    android:textColor="#17221A"
                                    android:textSize="19sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Duration"
                                    android:textColor="#505850"
                                    android:textSize="17sp" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="5dp"
                            app:cardBackgroundColor="#F0F8EC"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="HQ  480p"
                                    android:textColor="#17221A"
                                    android:textSize="19sp"
                                    android:textStyle="bold" />

                                <Spinner
                                    android:id="@+id/spVideoQuality"
                                    android:layout_width="match_parent"
                                    android:layout_height="38dp"
                                    android:gravity="center" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- SECOND ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="5dp"
                            app:cardBackgroundColor="#F0F8EC"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="▣  Camera"
                                    android:textColor="#17221A"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <RadioGroup
                                    android:id="@+id/rgCamera"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/rbBackCamera"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        android:text="Back"
                                        android:textSize="12sp" />

                                    <RadioButton
                                        android:id="@+id/rbFrontCamera"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Front"
                                        android:textSize="12sp" />

                                </RadioGroup>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="5dp"
                            app:cardBackgroundColor="#F0F8EC"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="◉  Preview"
                                    android:textColor="#17221A"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switchPreview"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:text="Show Preview"
                                    android:textSize="12sp" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- STORAGE INFORMATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/storageProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/txtStorageUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Used: 0 MB" />

            <TextView
                android:id="@+id/txtStorageAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available: 1 GB" />

            <TextView
                android:id="@+id/txtStoragePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%" />

            <TextView
                android:id="@+id/txtStorageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage information" />

        </LinearLayout>

        <!-- FIRST BANNER SPACE -->
        <FrameLayout
            android:id="@+id/bannerStorageAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- CAMERA PREVIEW CONTAINER -->
        <FrameLayout
            android:id="@+id/cameraPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtPreviewPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Camera Preview" />

        </FrameLayout>

        <!-- SECOND BANNER SPACE -->
        <FrameLayout
            android:id="@+id/bannerSettingsAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- FLEXIBLE EMPTY SPACE -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- RECORDING TIMER -->
        <TextView
            android:id="@+id/txtRecordingTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="00:00:00"
            android:textColor="#111111"
            android:textSize="54sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtQualityInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="18dp"
            android:text="Tap to record. You can lock the phone."
            android:textColor="#555B55"
            android:textSize="17sp" />

        <!-- FLASH, START AND PORTRAIT BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="205dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlash"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:backgroundTint="#DDF5E1"
                    android:text="ϟ"
                    android:textColor="#17221A"
                    android:textSize="35sp"
                    app:cornerRadius="50dp"
                    app:elevation="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="7dp"
                    android:text="Flash"
                    android:textColor="#303830"
                    android:textSize="18sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.65"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartRecording"
                    android:layout_width="178dp"
                    android:layout_height="178dp"
                    android:backgroundTint="#16864D"
                    android:text="▣&#10;Start"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:cornerRadius="100dp"
                    app:elevation="0dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPortrait"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:backgroundTint="#DDF5E1"
                    android:text="▱"
                    android:textColor="#17221A"
                    android:textSize="35sp"
                    app:cornerRadius="50dp"
                    app:elevation="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                 