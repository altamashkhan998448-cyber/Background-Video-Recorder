<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#080B0A"
android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BVR"
            android:textColor="#00D6A0"
            android:textSize="27sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtRecordingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● SETUP REQUIRED"
            android:textColor="#FFC15A"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Background Video Recorder"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Record videos privately in the background."
        android:textColor="#A5AAA8"
        android:textSize="14sp" />

    <!-- RECORDING PREVIEW -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="#151D1A"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CAMERA PREVIEW"
            android:textColor="#00D6A0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/cameraPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:layout_marginTop="12dp"
            android:background="#080B0A">

            <TextView
                android:id="@+id/txtPreviewPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Camera preview will appear here"
                android:textColor="#A5AAA8"
                android:textSize="14sp" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Show Live Preview"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="#00D6A0" />

        </LinearLayout>

    </LinearLayout>

    <!-- CAMERA SELECTION -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="SELECT CAMERA"
        android:textColor="#00D6A0"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#151D1A"
        android:orientation="horizontal"
        android:padding="12dp">

        <RadioButton
            android:id="@+id/rbBackCamera"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:buttonTint="#00D6A0"
            android:checked="true"
            android:text="Back Camera"
            android:textColor="#FFFFFF" />

        <RadioButton
            android:id="@+id/rbFrontCamera"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:buttonTint="#00D6A0"
            android:text="Front Camera"
            android:textColor="#FFFFFF" />

    </RadioGroup>

    <!-- VIDEO QUALITY -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="VIDEO QUALITY"
        android:textColor="#00D6A0"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spVideoQuality"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:background="#1B2521"
        android:padding="10dp" />

    <TextView
        android:id="@+id/txtQualityInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="480p and 720p FREE | 1080p AD UNLOCK"
        android:textColor="#00D6A0"
        android:textSize="12sp" />

    <!-- AUDIO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="18dp"
        android:background="#151D1A"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Record Audio"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switchAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:thumbTint="#00D6A0" />

    </LinearLayout>

    <!-- STORAGE -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="#151D1A"
        android:orientation="vertical"
        android:padding="17dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECORDING STORAGE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStorageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0 MB USED / 1 GB FREE"
            android:textColor="#00D6A0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Your free recording storage allowance"
            android:textColor="#A5AAA8"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- START RECORDING -->

    <Button
        android:id="@+id/btnStartRecording"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#00D6A0"
        android:text="● START RECORDING"
        android:textColor="#07100D"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- RECORDINGS -->

    <Button
        android:id="@+id/btnRecordings"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="13dp"
        android:backgroundTint="#1B2521"
        android:text="MY RECORDINGS"
        android:textColor="#FFFFFF" />

    <!-- SETTINGS -->

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#1B2521"
        android:text="SETTINGS"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="Use responsibly and follow local laws."
        android:textColor="#777F7B"
        android:textSize="12sp" />

</LinearLayout>

</ScrollView>