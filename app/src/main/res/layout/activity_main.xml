<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#080B0A"
android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BVR"
            android:textColor="#00D6A0"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● READY"
            android:textColor="#00D6A0"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Background Video Recorder"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Capture important moments while using other apps."
        android:textColor="#A5AAA8"
        android:textSize="14sp" />

    <!-- RECORDING CARD -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="26dp"
        android:background="#151D1A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#FF4545"
            android:textSize="35sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="READY TO RECORD"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Your camera is currently inactive"
            android:textColor="#A5AAA8"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- STORAGE CARD -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="#151D1A"
        android:orientation="vertical"
        android:padding="17dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STORAGE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="1 GB FREE STORAGE"
            android:textColor="#00D6A0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Your free recording storage allowance"
            android:textColor="#A5AAA8"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- RECORDING SETTINGS INFO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#151D1A"
        android:orientation="vertical"
        android:padding="17dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECORDING SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Video Quality       1080p"
            android:textColor="#D6DEDA"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Camera                 Back Camera"
            android:textColor="#D6DEDA"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- START RECORDING -->

    <Button
        android:id="@+id/btnStartRecording"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="23dp"
        android:backgroundTint="#00D6A0"
        android:text="START RECORDING"
        android:textColor="#07100D"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- RECORDINGS -->

    <Button
        android:id="@+id/btnRecordings"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="13dp"
        android:backgroundTint="#1B2521"
        android:text="MY RECORDINGS"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- SETTINGS -->

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#1B2521"
        android:text="SETTINGS"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Use responsibly and follow local laws."
        android:textColor="#777F7B"
        android:textSize="12sp" />

</LinearLayout>

</ScrollView>